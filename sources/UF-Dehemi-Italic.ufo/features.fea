# GDEF Mark Attachment Sets
@MarkSet0=[\uni0308 \uni0307 \gravecomb \acutecomb \uni030B \uni0302 \uni030C \uni0306 
	\uni030A \tildecomb \uni0304 \hookabovecomb \uni030F \uni0311 \uni0312 ];
@MarkSet1=[\sinVirama ];
@MarkSet2=[\uni0308 \uni0307 \gravecomb \acutecomb \uni030B \uni0302 \uni030C \uni0306 
	\uni030A \tildecomb \uni0304 \hookabovecomb \uni030F \uni0311 \uni0312 
	\uni031B \dotbelowcomb ];

